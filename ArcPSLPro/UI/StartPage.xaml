<UserControl x:Class="ArcPSLPro.UI.StartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="clr-namespace:ArcPSLPro.UI"
             xmlns:local="clr-namespace:ArcPSLPro"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:helpers="clr-namespace:ArcPSLPro.Helpers"
             xmlns:controls="clr-namespace:ArcGIS.Desktop.Core.Controls;assembly=ArcGIS.Desktop.Core"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1000" Background="{DynamicResource App_LightGray}">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component\Themes\Default.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/ArcPSLPro;component\Styles\DrawingImages.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/ArcPSLPro;component\Styles\ControlStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid x:Name="WindowContent">
    <Grid.Background>
      <ImageBrush x:Name="BackgroundBrush"
                  ImageSource="pack://application:,,,/ArcPSLPro;component/Images/background.jpg"
                  Stretch="UniformToFill"/>
    </Grid.Background>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid x:Name="Header" Grid.Row="0" Height="65" VerticalAlignment="Top"
          Background="{DynamicResource HeaderBackground}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Grid x:Name="Logo" Grid.Column="0" Margin="20,0,0,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="pack://application:,,,/ArcPSLPro;component/Images/favicon.ico"
                 Width="32" Height="32" Stretch="Uniform" VerticalAlignment="Center"/>
          <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                     FontSize="18" FontWeight="SemiBold">
            <Run Text="ArcPSL " Foreground="#F7E7D0"/>
            <Run Text="Pro"     Foreground="#DA8F4A"/>
          </TextBlock>
        </StackPanel>
      </Grid>

      <!-- SignIn Control-->
      <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,6,15,5" Background="{DynamicResource SignOnBackdrop}"
              CornerRadius="4" Padding="8,4">
        <controls:SignOnControl x:Name="SignOn"/>
      </Border>

    </Grid>

    <Grid Grid.Row="1" x:Name="Body" Background="{DynamicResource BodyBackground}">
      <Grid.RowDefinitions>
          <RowDefinition Height="55"/>
          <RowDefinition Height="175"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border BorderThickness="1" Margin="0,0,20,0"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Background="{DynamicResource App_ControlBackground}"
                BorderBrush="{DynamicResource App_ControlBackground}"
                Grid.Column="0" Grid.Row="1"
                Width="161"
                MinHeight="161"
                CornerRadius="0,3,3,0">

          <Grid Margin="10">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Home button -->
            <ToggleButton Grid.Row="0"
                          x:Name="NavHomeButton"
                          Content="Home"
                          Command="{Binding NavigationCommand}"
                          CommandParameter="Home">
              <ToggleButton.Style>
                <Style BasedOn="{StaticResource NavigationToggleButtonStyle}" TargetType="ToggleButton">
                  <Setter Property="Tag" Value="{DynamicResource Home24}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentNavPage}" Value="0">
                      <Setter Property="IsChecked" Value="True"/>
                    </DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Tag" Value="{DynamicResource Home24Hover}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter Property="Tag" Value="{DynamicResource Home24Hover}"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter Property="Tag" Value="{DynamicResource Home24Hover}"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </ToggleButton.Style>
            </ToggleButton>

            <!-- Learn button -->
            <ToggleButton Grid.Row="1"
                          x:Name="NavResourcesButton"
                          Content="Learning Resources"
                          Command="{Binding NavigationCommand}"
                          CommandParameter="Resources"
                          Margin="0,4,0,0">
              <ToggleButton.Style>
                <Style BasedOn="{StaticResource NavigationToggleButtonStyle}" TargetType="ToggleButton">
                  <Setter Property="Tag" Value="{DynamicResource Resources24}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentNavPage}" Value="1">
                      <Setter Property="IsChecked" Value="True"/>
                    </DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Tag" Value="{DynamicResource Resources24Hover}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter Property="Tag" Value="{DynamicResource Resources24Hover}"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter Property="Tag" Value="{DynamicResource Resources24Hover}"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </ToggleButton.Style>
            </ToggleButton>

            <Border Grid.Row="2"
                    Height="1"
                    Background="{DynamicResource App_LightGray2}"
                    Margin="0,5,0,5"
                  CornerRadius="3"/>

            <!-- Settings button -->
            <Button Grid.Row="3"
                    x:Name="NavSettingsButton"
                    Content="Settings"
                    Command="{Binding NavigationCommand}"
                    CommandParameter="Settings">
              <Button.Style>
                <Style BasedOn="{StaticResource NavigationButtonStyle}" TargetType="Button">
                  <Setter Property="Tag" Value="{DynamicResource Settings24}"/>
                  <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Tag" Value="{DynamicResource Settings24Hover}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter Property="Tag" Value="{DynamicResource Settings24Hover}"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </Grid>

        </Border>

      <Grid Grid.Row="0" Grid.Column="1" Grid.RowSpan="3">
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  CanContentScroll="True" Margin="0,0,0,10">

          <i:Interaction.Behaviors>
            <helpers:PropagateMouseWheelBehavior/>
          </i:Interaction.Behaviors>

          <ContentPresenter Content="{Binding Path=ControlContent}"></ContentPresenter>

        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
