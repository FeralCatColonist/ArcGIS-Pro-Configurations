<UserControl x:Class="ArcPSLPro.UI.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component\Themes\Default.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <StackPanel Margin="20">
    <TextBlock Text="ArcPSL Pro" Style="{DynamicResource Esri_TextBlockH1}"/>
    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
               Text="Fall seasonal theme for ArcGIS Pro. ArcPSL Pro — a popular seasonal geospatial desktop application made with warm autumn spices, steamed milk, and espresso."/>
    <TextBlock Margin="0,12,0,0" Text="Inspired by Microslop Mico: Live, Laugh, [Pumpkin Spice Latte]."/>
  </StackPanel>
</UserControl>
